      ]
    },
    {
      "id": "RELOC-05",
      "operation": "patchPlace",
      "given": [
        "馆区 00000000-0000-4000-8000-000000000017 在 00000000-0000-4000-8000-000000000042 有生效版。目的辖区 00000000-0000-4000-8000-000000000051 与源侧分属不同国家。",
        "操作者具备双侧权限。"
      ],
      "request": {
        "path": {
          "id": "00000000-0000-4000-8000-000000000017"
        },
        "headers": {
          "x-csrf-token": "fixture-relocation-token"
        },
        "body": {
          "expectedRevision": 12,
          "fields": {
            "areaId": "00000000-0000-4000-8000-000000000051"
          }
        }
      },
      "response": {
        "status": 409,
        "body": {
          "code": "RELOCATION_BLOCKED",
          "requestId": "reloc-05"
        }
      },
      "assertions": [
        "馆区仍对原国家生效。关闭旧公开入口并处理发布依赖后才允许重新提交跨国归属。"
      ]
    },
    {
      "id": "RELOC-06",
      "operation": "patchPlace",
      "given": [
        "操作者具备双侧权限。打开编辑后，另一个请求已将馆区记录修订从 12 更新到 13。"
      ],
      "request": {
        "path": {
          "id": "00000000-0000-4000-8000-000000000017"
        },
        "headers": {
          "x-csrf-token": "fixture-relocation-token"
        },
        "body": {
