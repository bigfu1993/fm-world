{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fm-world.test/contracts/v1/relocation.schema.json",
  "title": "行政区和地点的普通编辑与归属迁移",
  "description": "同一资源 PATCH 用互斥请求形状区分普通编辑与单归属键迁移。200 回显本次获准写入的字段。发布与审批使用各自的操作。",
  "definitions": {
    "Path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
        }
      }
    },
    "AreaRelocationFields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parentId"
      ],
      "properties": {
        "parentId": {
          "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
        }
      }
    },
    "PlaceRelocationFields": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "areaId"
          ],
          "properties": {
            "areaId": {
              "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "parentPlaceId"
          ],
          "properties": {
            "parentPlaceId": {
              "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
            }
          }
        }
      ]
    },
    "Malformed": {
      "allOf": [
        {
          "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Error"
        },
        {
          "properties": {
            "code": {
              "const": "MALFORMED_REQUEST"
            }
          }
        }
      ]
    },
    "SessionInvalid": {
      "allOf": [
        {
          "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Error"
        },
        {
          "properties": {
            "code": {
              "const": "SESSION_INVALID"
            }
          }
        }
      ]
    },
    "Forbidden": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Error"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "requestId"
              ],
              "properties": {
                "code": {
                  "const": "ACTION_FORBIDDEN"
                },
                "requestId": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Error"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "requestId"
              ],
              "properties": {
                "code": {
                  "const": "CSRF_INVALID"
                },
                "requestId": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        }
      ]
    },
    "NotFound": {
      "allOf": [
        {
          "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Error"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "requestId"
          ],
          "properties": {
            "code": {
              "const": "RECORD_NOT_FOUND"
            },
            "requestId": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "Conflict": {
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Error"
            },
            {
              "properties": {
                "code": {
                  "const": "REVISION_CONFLICT"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Error"
            },
            {
              "properties": {
                "code": {
                  "const": "RELOCATION_BLOCKED"
                }
              }
            }
          ]
        }
      ]
    },
    "InvalidRelocation": {
      "allOf": [
        {
          "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Error"
        },
        {
          "properties": {
            "code": {
              "const": "VALIDATION_FAILED"
            }
          }
        }
      ]
    },
    "OfficialName": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "locale",
            "sourceId",
            "value"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "name",
                "address",
                "signage"
              ]
            },
            "locale": {
              "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Locale"
            },
            "sourceId": {
              "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "locale",
            "sourceId",
            "nameRef"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "name",
                "address",
                "signage"
              ]
            },
            "locale": {
              "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Locale"
            },
            "sourceId": {
              "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
            },
            "nameRef": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "recordId",
                "locale",
                "field"
              ],
              "properties": {
                "recordId": {
                  "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
                },
                "locale": {
                  "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Locale"
                },
                "field": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      ]
    },
    "ExactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "referenceVersionId"
      ],
      "properties": {
        "id": {
          "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
        },
        "referenceVersionId": {
          "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
        }
      }
    },
    "AreaEditFields": {
      "description": "普通字段分支。配置字段只能用于实际类型为 country 的记录，areaLevel 更新按已有父子关系及已核验配置验证。",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
          },
          "uniqueItems": true
        },
        "officialNames": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/OfficialName"
          }
        },
        "areaLevel": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "not": {
            "const": "country"
          }
        },
        "geometryId": {
          "oneOf": [
            {
              "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "areaLevels": {
          "$ref": "https://fm-world.test/contracts/v1/country-configuration.schema.json#/definitions/DraftAreaLevels"
        },
        "postalCodeRule": {
          "$ref": "https://fm-world.test/contracts/v1/country-configuration.schema.json#/definitions/PostalCodeRule"
        },
        "officialLocales": {
          "$ref": "https://fm-world.test/contracts/v1/country-configuration.schema.json#/definitions/DraftOfficialLocales"
        },
        "configurationSources": {
          "$ref": "https://fm-world.test/contracts/v1/country-configuration.schema.json#/definitions/DraftConfigurationSources"
        }
      },
      "minProperties": 1
    },
    "PlaceEditFields": {
      "description": "普通字段分支。服务端按目标实际类型校验可编辑字段。经纬度成对更新或成对清空，迁移字段从此分支排除。",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
          },
          "uniqueItems": true
        },
        "officialNames": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/OfficialName"
          }
        },
        "organizationId": {
          "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
        },
        "entranceIds": {
          "type": "array",
          "items": {
            "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
          },
          "uniqueItems": true
        },
        "contentRefs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ExactReference"
          },
          "uniqueItems": true
        },
        "streetNumber": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "postalCode": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "latitude": {
          "oneOf": [
            {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            {
              "type": "null"
            }
          ]
        },
        "longitude": {
          "oneOf": [
            {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "minProperties": 1,
      "if": {
        "anyOf": [
          {
            "required": [
              "latitude"
            ]
          },
          {
            "required": [
              "longitude"
            ]
          }
        ]
      },
      "then": {
        "required": [
          "latitude",
          "longitude"
        ],
        "oneOf": [
          {
            "properties": {
              "latitude": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "longitude": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            }
          },
          {
            "properties": {
              "latitude": {
                "type": "null"
              },
              "longitude": {
                "type": "null"
              }
            }
          }
        ]
      }
    },
    "AreaPatchFields": {
      "oneOf": [
        {
          "$ref": "#/definitions/AreaEditFields"
        },
        {
          "$ref": "#/definitions/AreaRelocationFields"
        }
      ]
    },
    "AreaPatchRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "headers",
        "body"
      ],
      "properties": {
        "path": {
          "$ref": "#/definitions/Path"
        },
        "headers": {
          "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/CsrfHeaders"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expectedRevision",
            "fields"
          ],
          "properties": {
            "expectedRevision": {
              "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Revision"
            },
            "fields": {
              "$ref": "#/definitions/AreaPatchFields"
            }
          }
        }
      }
    },
    "AreaPatchResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "fields"
      ],
      "properties": {
        "id": {
          "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
        },
        "revision": {
          "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Revision"
        },
        "fields": {
          "$ref": "#/definitions/AreaPatchFields"
        }
      }
    },
    "PlacePatchFields": {
      "oneOf": [
        {
          "$ref": "#/definitions/PlaceEditFields"
        },
        {
          "$ref": "#/definitions/PlaceRelocationFields"
        }
      ]
    },
    "PlacePatchRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "headers",
        "body"
      ],
      "properties": {
        "path": {
          "$ref": "#/definitions/Path"
        },
        "headers": {
          "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/CsrfHeaders"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expectedRevision",
            "fields"
          ],
          "properties": {
            "expectedRevision": {
              "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Revision"
            },
            "fields": {
              "$ref": "#/definitions/PlacePatchFields"
            }
          }
        }
      }
    },
    "PlacePatchResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "fields"
      ],
      "properties": {
        "id": {
          "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
        },
        "revision": {
          "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Revision"
        },
        "fields": {
          "$ref": "#/definitions/PlacePatchFields"
        }
      }
    }
  },
  "x-operations": {
    "patchArea": {
      "method": "PATCH",
      "path": "/api/areas/{id}",
      "request": "#/definitions/AreaPatchRequest",
      "responses": {
        "200": "#/definitions/AreaPatchResponse",
        "400": "#/definitions/Malformed",
        "401": "#/definitions/SessionInvalid",
        "403": "#/definitions/Forbidden",
        "404": "#/definitions/NotFound",
        "409": "#/definitions/Conflict",
        "422": "#/definitions/InvalidRelocation"
      }
    },
    "patchPlace": {
      "method": "PATCH",
      "path": "/api/places/{id}",
      "request": "#/definitions/PlacePatchRequest",
      "responses": {
        "200": "#/definitions/PlacePatchResponse",
        "400": "#/definitions/Malformed",
        "401": "#/definitions/SessionInvalid",
        "403": "#/definitions/Forbidden",
        "404": "#/definitions/NotFound",
        "409": "#/definitions/Conflict",
        "422": "#/definitions/InvalidRelocation"
      }
    }
  },
  "x-examples": [
    {
      "id": "RELOC-01",
      "operation": "patchArea",
      "given": [
        "已发布行政区 00000000-0000-4000-8000-000000000040 当前记录修订为 7，生效版本 00000000-0000-4000-8000-000000000801 的正式上级为 00000000-0000-4000-8000-000000000042。",
        "目标 00000000-0000-4000-8000-000000000041 与现辖区属同一国家，父级类型合法，无待处理的生效后代或必需引用影响。",
        "当前账号在移出、移入两侧分别有 records.read 和 records.edit。"
      ],
      "request": {
        "path": {
          "id": "00000000-0000-4000-8000-000000000040"
        },
        "headers": {
          "x-csrf-token": "fixture-relocation-token"
        },
        "body": {
          "expectedRevision": 7,
          "fields": {
            "parentId": "00000000-0000-4000-8000-000000000041"
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "id": "00000000-0000-4000-8000-000000000040",
          "revision": 8,
          "fields": {
            "parentId": "00000000-0000-4000-8000-000000000041"
          }
        }
      },
      "assertions": [
        "读取草稿时，仍使用 00000000-0000-4000-8000-000000000042 判定权限，双侧有权的操作者看见拟上级 00000000-0000-4000-8000-000000000041。",
        "审批前公开搜索、父链和生效预览仍沿 00000000-0000-4000-8000-000000000042。仅有目标侧权限的运营账号仍无法读取草稿。",
        "只读源侧的账号仍可查看旧范围内的记录。草稿响应省略其无权读取的拟归属 ID 和详情，现行归属保持可见。",
        "同一待审版本保持冻结的源、目标和路径。双侧发布权限及影响均通过时，正式归属与版本 00000000-0000-4000-8000-000000000802 同一事务生效。",
        "批准后公开父链和授权切换至 00000000-0000-4000-8000-000000000041。仅有 00000000-0000-4000-8000-000000000042 的账号无法读取当前记录。",
        "历史版本 00000000-0000-4000-8000-000000000801 继续显示原父链，仅当前侧和历史侧都有读取及请求语种权限的账号可见。"
      ]
    },
    {
      "id": "RELOC-02",
      "operation": "patchArea",
      "given": [
        "行政区仍位于 00000000-0000-4000-8000-000000000042，操作者可读并可编辑源侧记录。",
        "操作者可读目标辖区，但在目标侧没有 records.edit。"
      ],
      "request": {
        "path": {
          "id": "00000000-0000-4000-8000-000000000040"
        },
        "headers": {
          "x-csrf-token": "fixture-relocation-token"
        },
        "body": {
          "expectedRevision": 7,
          "fields": {
            "parentId": "00000000-0000-4000-8000-000000000041"
          }
        }
      },
      "response": {
        "status": 403,
        "body": {
          "code": "ACTION_FORBIDDEN",
          "requestId": "reloc-02"
        }
      },
      "assertions": [
        "响应只给统一无权错误。不更新草稿、修订、公开状态或待审申请。"
      ]
    },
    {
      "id": "RELOC-03",
      "operation": "patchArea",
      "given": [
        "操作者只在移入侧有授权，可以查看目标辖区，源侧记录对其不可见。",
        "操作者已知源侧稳定 ID。"
      ],
      "request": {
        "path": {
          "id": "00000000-0000-4000-8000-000000000040"
        },
        "headers": {
          "x-csrf-token": "fixture-relocation-token"
        },
        "body": {
          "expectedRevision": 7,
          "fields": {
            "parentId": "00000000-0000-4000-8000-000000000041"
          }
        }
      },
      "response": {
        "status": 404,
        "body": {
          "code": "RECORD_NOT_FOUND",
          "requestId": "reloc-03"
