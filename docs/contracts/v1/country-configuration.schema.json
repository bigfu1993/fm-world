{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fm-world.test/contracts/v1/country-configuration.schema.json",
  "title": "国家草稿、配置核验和下级辖区录入",
  "description": "M2 从空地理库创建国家，配置保存在国家草稿。独立核验后才转成可依赖的配置版本，原有公开状态不变。",
  "definitions": {
    "AreaLevelCode": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "AreaLevel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "allowedParentCodes"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "not": {
            "const": "country"
          }
        },
        "allowedParentCodes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AreaLevelCode"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "DraftAreaLevels": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/AreaLevel"
      },
      "uniqueItems": true
    },
    "VerifiedAreaLevels": {
      "$ref": "#/definitions/DraftAreaLevels"
    },
    "PostalCodeRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "formatCode"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "formatCode": {
          "type": "string",
          "enum": [
            "free-text",
            "six-digits",
            "five-digits"
          ]
        }
      }
    },
    "DraftOfficialLocales": {
      "type": "array",
      "items": {
        "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Locale"
      },
      "uniqueItems": true
    },
    "VerifiedOfficialLocales": {
      "allOf": [
        {
          "$ref": "#/definitions/DraftOfficialLocales"
        },
        {
          "minItems": 1
        }
      ]
    },
    "DraftConfigurationSources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "areaLevels",
        "postalCodeRule",
        "officialLocales"
      ],
      "properties": {
        "areaLevels": {
          "type": "array",
          "items": {
            "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
          },
          "uniqueItems": true
        },
        "postalCodeRule": {
          "type": "array",
          "items": {
            "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
          },
          "uniqueItems": true
        },
        "officialLocales": {
          "type": "array",
          "items": {
            "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
          },
          "uniqueItems": true
        }
      }
    },
    "VerifiedConfigurationSources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "areaLevels",
        "postalCodeRule",
        "officialLocales"
      ],
      "properties": {
        "areaLevels": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/VerifiedSourceReference"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "postalCodeRule": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/VerifiedSourceReference"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "officialLocales": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/VerifiedSourceReference"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "VerifiedConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "countryId",
        "referenceVersionId",
        "areaLevels",
        "postalCodeRule",
        "officialLocales"
      ],
      "properties": {
        "countryId": {
          "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
        },
        "referenceVersionId": {
          "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
        },
        "areaLevels": {
          "$ref": "#/definitions/VerifiedAreaLevels"
        },
        "postalCodeRule": {
          "$ref": "#/definitions/PostalCodeRule"
        },
        "officialLocales": {
          "$ref": "#/definitions/VerifiedOfficialLocales"
        }
      }
    },
    "VerifiedCountryConfigurationSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "countryId",
        "referenceVersionId",
        "areaLevels",
        "postalCodeRule",
        "officialLocales",
        "configurationSources"
      ],
      "properties": {
        "countryId": {
          "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
        },
        "referenceVersionId": {
          "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
        },
        "areaLevels": {
          "$ref": "#/definitions/VerifiedAreaLevels"
        },
        "postalCodeRule": {
          "$ref": "#/definitions/PostalCodeRule"
        },
        "officialLocales": {
          "$ref": "#/definitions/VerifiedOfficialLocales"
        },
        "configurationSources": {
          "$ref": "#/definitions/VerifiedConfigurationSources"
        }
      },
      "description": "独立核验时冻结三组字段及每项来源采用的确切版本。GET 配置投影只读取录入所需规则。"
    },
    "CreateAreaRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headers",
        "body"
      ],
      "properties": {
        "headers": {
          "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/CsrfHeaders"
        },
        "body": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "sourceLocale",
                "code",
                "areaLevel",
                "parentId"
              ],
              "properties": {
                "type": {
                  "const": "country"
                },
                "sourceLocale": {
                  "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Locale"
                },
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "areaLevel": {
                  "const": "country"
                },
                "parentId": {
                  "const": null
                },
                "sourceIds": {
                  "type": "array",
                  "items": {
                    "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
                  },
                  "uniqueItems": true
                },
                "geometryId": {
                  "oneOf": [
                    {
                      "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "sourceLocale",
                "code",
                "areaLevel",
                "parentId"
              ],
              "properties": {
                "type": {
                  "const": "administrative-area"
                },
                "sourceLocale": {
                  "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Locale"
                },
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "areaLevel": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$",
                  "not": {
                    "const": "country"
                  }
                },
                "parentId": {
                  "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
                },
                "sourceIds": {
                  "type": "array",
                  "items": {
                    "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
                  },
                  "uniqueItems": true
                },
                "geometryId": {
                  "oneOf": [
                    {
                      "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "CreateAreaResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "fields"
      ],
      "properties": {
        "id": {
          "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
        },
        "revision": {
          "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Revision"
        },
        "fields": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "areaLevel",
                "parentId"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "areaLevel": {
                  "const": "country"
                },
                "parentId": {
                  "const": null
                },
                "sourceIds": {
                  "type": "array",
                  "items": {
                    "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
                  },
                  "uniqueItems": true
                },
                "geometryId": {
                  "oneOf": [
                    {
                      "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "areaLevel",
                "parentId"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "areaLevel": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$",
                  "not": {
                    "const": "country"
                  }
                },
                "parentId": {
                  "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
                },
                "sourceIds": {
                  "type": "array",
                  "items": {
                    "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
                  },
                  "uniqueItems": true
                },
                "geometryId": {
                  "oneOf": [
                    {
                      "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "ReviewRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "headers",
        "body"
      ],
      "properties": {
        "path": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
            }
          }
        },
        "headers": {
          "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/CsrfHeaders"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expectedDraftRevision",
            "decision",
            "reason"
          ],
          "properties": {
            "expectedDraftRevision": {
              "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Revision"
            },
            "decision": {
              "type": "string",
              "enum": [
                "approve",
                "reject"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "ReviewResponse": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "countryId",
            "status",
            "referenceVersionId"
          ],
          "properties": {
            "id": {
              "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
            },
            "countryId": {
              "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
            },
            "status": {
              "const": "verified"
            },
            "referenceVersionId": {
              "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "countryId",
            "status",
            "referenceVersionId"
          ],
          "properties": {
            "id": {
              "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
            },
            "countryId": {
              "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
            },
            "status": {
              "const": "rejected"
            },
            "referenceVersionId": {
              "const": null
            }
          }
        }
      ]
    },
    "ReadConfigurationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
            }
          }
        }
      }
    },
    "ConfigurationNotFound": {
      "allOf": [
        {
          "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Http404Error"
        },
        {
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "RECORD_NOT_FOUND",
                "COUNTRY_CONFIGURATION_UNAVAILABLE"
              ]
            }
          }
        }
      ]
    },
    "AreaNotFound": {
      "allOf": [
        {
          "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Http404Error"
        },
        {
          "properties": {
            "code": {
              "const": "RECORD_NOT_FOUND"
            }
          }
        }
      ]
    },
    "VerifiedSourceReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
        },
        "referenceVersionId": {
          "$ref": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Id"
        }
      },
      "required": [
        "id",
        "referenceVersionId"
      ]
    }
  },
  "x-operations": {
    "createArea": {
      "method": "POST",
      "path": "/api/areas",
      "request": "#/definitions/CreateAreaRequest",
      "responses": {
        "201": "#/definitions/CreateAreaResponse",
        "400": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Http400Error",
        "401": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Http401Error",
        "403": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Http403Error",
        "404": "#/definitions/AreaNotFound",
        "409": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Http409Error",
        "422": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Http422Error"
      }
    },
    "reviewCountryConfiguration": {
      "method": "POST",
      "path": "/api/areas/{id}/configuration-reviews",
      "request": "#/definitions/ReviewRequest",
      "responses": {
        "201": "#/definitions/ReviewResponse",
        "400": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Http400Error",
        "401": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Http401Error",
        "403": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Http403Error",
        "404": "#/definitions/AreaNotFound",
        "409": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Http409Error",
        "422": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Http422Error"
      }
    },
    "readVerifiedConfiguration": {
      "method": "GET",
      "path": "/api/geographic-nodes/{id}/configuration",
      "request": "#/definitions/ReadConfigurationRequest",
      "responses": {
        "200": "#/definitions/VerifiedConfiguration",
        "400": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Http400Error",
        "401": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Http401Error",
        "403": "https://fm-world.test/contracts/v1/common.schema.json#/definitions/Http403Error",
        "404": "#/definitions/ConfigurationNotFound"
      }
    }
  },
  "x-examples": [
    {
      "id": "COUNTRY-01",
      "operation": "createArea",
      "given": [
        "M2 地理库为空，账号可在根作用域新建国家。",
        "源记录和语言目录已可用。"
      ],
      "request": {
        "headers": {
          "x-csrf-token": "fixture-country-configuration-token"
        },
        "body": {
          "type": "country",
          "sourceLocale": "zh",
          "code": "XQ",
          "areaLevel": "country",
          "parentId": null,
          "sourceIds": [
            "00000000-0000-4000-8000-000000000921"
          ]
        }
      },
      "response": {
        "status": 201,
        "body": {
          "id": "00000000-0000-4000-8000-000000000915",
          "revision": 0,
          "fields": {
            "code": "XQ",
            "areaLevel": "country",
            "parentId": null,
            "sourceIds": [
              "00000000-0000-4000-8000-000000000921"
            ]
          }
        }
      },
      "assertions": [
        "创建国家根且无父级，初始 draftRevision 与共享 revision 均为 0。",
        "配置读取仍按 COUNTRY-02，不能推导已核验配置或公开版本。"
      ]
    },
    {
      "id": "COUNTRY-02",
      "operation": "readVerifiedConfiguration",
      "given": [
        "COUNTRY-01 后账号可读国家，尚未核验配置。"
      ],
      "request": {
        "path": {
          "id": "00000000-0000-4000-8000-000000000915"
        }
      },
      "response": {
        "status": 404,
        "body": {
          "code": "COUNTRY_CONFIGURATION_UNAVAILABLE",
          "requestId": "country-02"
        }
      },
      "assertions": [
        "空库未核验状态与记录不可见分开。",
        "不使用默认层级、邮编规则或草稿填补。"
      ]
    },
    {
      "id": "COUNTRY-03",
      "operation": "createArea",
      "given": [
        "账号可在国家范围创建下级行政区，已执行 EDIT-03 但未核验。"
      ],
      "request": {
        "headers": {
          "x-csrf-token": "fixture-country-configuration-token"
        },
        "body": {
          "type": "administrative-area",
          "sourceLocale": "zh",
          "code": "XQ-P1",
          "areaLevel": "province",
          "parentId": "00000000-0000-4000-8000-000000000915",
          "sourceIds": [
            "00000000-0000-4000-8000-000000000921"
          ]
        }
      },
      "response": {
        "status": 422,
        "body": {
          "code": "VALIDATION_FAILED",
          "requestId": "country-03",
          "issues": [
            {
              "field": "areaLevel",
              "code": "COUNTRY_CONFIGURATION_UNAVAILABLE"
            }
          ]
        }
      },
      "assertions": [
        "正要录子区时验证已核验配置，草稿完整也不能预先使用。",
        "不写入下级行政区。"
      ]
    },
    {
      "id": "COUNTRY-04",
      "operation": "reviewCountryConfiguration",
      "given": [
        "已执行 EDIT-03，国家聚合草稿修订为 1。",
        "账号在该国家具备 records.read 与 catalog.review，三组来源均已核验。"
      ],
      "request": {
        "path": {
          "id": "00000000-0000-4000-8000-000000000915"
        },
        "headers": {
          "x-csrf-token": "fixture-country-configuration-token"
        },
        "body": {
          "expectedDraftRevision": 1,
          "decision": "approve",
          "reason": "层级、邮编与官方语言来源完整"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "id": "00000000-0000-4000-8000-000000000930",
          "countryId": "00000000-0000-4000-8000-000000000915",
          "status": "verified",
          "referenceVersionId": "00000000-0000-4000-8000-000000000931"
        }
      },
      "assertions": [
        "以同一事务锁定国家草稿修订，冻结完整配置和有效来源依据。",
        "更新核验配置指针，国家公开版本保持原状态。"
      ]
    },
    {
      "id": "COUNTRY-05",
      "operation": "readVerifiedConfiguration",
      "given": [
        "COUNTRY-04 核验完成，尚未完成 M4 发布。",
        "账号可读该国家。"
      ],
      "request": {
        "path": {
          "id": "00000000-0000-4000-8000-000000000915"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "countryId": "00000000-0000-4000-8000-000000000915",
          "referenceVersionId": "00000000-0000-4000-8000-000000000931",
          "areaLevels": [
            {
              "code": "province",
              "allowedParentCodes": [
                "country"
              ]
            },
            {
              "code": "city",
              "allowedParentCodes": [
                "province"
              ]
            }
          ],
          "postalCodeRule": {
            "required": true,
            "formatCode": "six-digits"
          },
          "officialLocales": [
            "zh",
            "en"
          ]
        }
      },
      "assertions": [
        "M2 配置读取立即使用该核验版本。",
        "配置读模型含三组规则，不隐式发布国家。"
      ]
    },
    {
      "id": "COUNTRY-06",
      "operation": "createArea",
      "given": [
        "COUNTRY-05 核验配置允许 province 从属于 country。",
        "账号有该国家下级行政区录入权限。"
      ],
      "request": {
        "headers": {
          "x-csrf-token": "fixture-country-configuration-token"
        },
        "body": {
          "type": "administrative-area",
